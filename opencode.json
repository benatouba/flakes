{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "agent-browser": {
      "enabled": true
    }
  },
  "share": "disabled",
  "permission": {
    "bash": {
      "*": "ask",
      "git *": "allow",
      "gh *": "allow",
      "pnpm *": "allow",
      "rm *": "ask",
      "grep *": "allow",
      "ls *": "allow",
      "just *": "allow",
      "nh *": "allow",
      "nix *": "allow",
      "cat *": "allow",
      "curl *": "allow",
      "echo *": "allow",
      "mkdir *": "allow",
      "touch *": "allow",
      "mv *": "allow",
      "cp *": "allow",
      "chmod *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "fd *": "allow",
      "rg *": "allow"
    }
  }
}

{
  "$schema": "https://opencode.ai/config.json",

  "plugins": [
    // Requires a V2-compatible release; renaming this key does not port the plugin.
    "envsitter-guard@latest",
    "@contextMode@",
  ],
  "lsp": true,
  "mcp": {
    "servers": {
      "vuetify-mcp": {
        "type": "remote",
        "url": "https://mcp.vuetifyjs.com/mcp",
        "disabled": false,
        "timeout": {
          "catalog": 5000,
          "execution": 5000,
        },
      },
      "playwright": {
        "type": "local",
        "command": ["playwright-mcp"],
        "disabled": true,
      },

      "agent-browser": {
        "type": "local",
        "command": ["agent-browser", "mcp", "--tools", "core,debug"],
        "disabled": true,
      },

      // Generated by Home Manager only when the personal Jev wrapper exists.
      @jevMcpServer@

      "chrome-devtools": {
        "type": "local",
        "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
        "disabled": true,
      },
    },
  },

  "permissions": [
    // Skills and read-only discovery tools.
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },

    // Ask before edits; disallow edits through these tools in the Nix store.
    { "action": "edit", "resource": "*", "effect": "ask" },
    { "action": "edit", "resource": "/nix/store/**", "effect": "deny" },

    // Shell commands ask by default, with the original exceptions below.
    { "action": "shell", "resource": "*", "effect": "ask" },

    // Version control and forge.
    { "action": "shell", "resource": "git *", "effect": "allow" },
    { "action": "shell", "resource": "gh *", "effect": "allow" },
    { "action": "shell", "resource": "jj *", "effect": "allow" },

    // Nix and development environments.
    // These broad allowances include more than read-only inspection.
    { "action": "shell", "resource": "nix *", "effect": "allow" },
    { "action": "shell", "resource": "devenv *", "effect": "allow" },
    { "action": "shell", "resource": "direnv *", "effect": "allow" },
    { "action": "shell", "resource": "just *", "effect": "allow" },

    // Shell introspection and coreutils.
    { "action": "shell", "resource": "which *", "effect": "allow" },
    { "action": "shell", "resource": "command *", "effect": "allow" },
    { "action": "shell", "resource": "type *", "effect": "allow" },
    { "action": "shell", "resource": "pwd *", "effect": "allow" },
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "cat *", "effect": "allow" },
    { "action": "shell", "resource": "head *", "effect": "allow" },
    { "action": "shell", "resource": "tail *", "effect": "allow" },
    { "action": "shell", "resource": "wc *", "effect": "allow" },
    { "action": "shell", "resource": "tree *", "effect": "allow" },
    { "action": "shell", "resource": "file *", "effect": "allow" },
    { "action": "shell", "resource": "stat *", "effect": "allow" },
    { "action": "shell", "resource": "realpath *", "effect": "allow" },
    { "action": "shell", "resource": "readlink *", "effect": "allow" },
    { "action": "shell", "resource": "echo *", "effect": "allow" },
    { "action": "shell", "resource": "printf *", "effect": "allow" },
    { "action": "shell", "resource": "diff *", "effect": "allow" },

    // Search, filtering, and structured-data inspection.
    { "action": "shell", "resource": "grep *", "effect": "allow" },
    { "action": "shell", "resource": "rg *", "effect": "allow" },
    { "action": "shell", "resource": "fd *", "effect": "allow" },
    { "action": "shell", "resource": "find *", "effect": "allow" },
    { "action": "shell", "resource": "jq *", "effect": "allow" },
    { "action": "shell", "resource": "yq *", "effect": "allow" },
    { "action": "shell", "resource": "perl *", "effect": "allow" },
    { "action": "shell", "resource": "awk *", "effect": "allow" },
    { "action": "shell", "resource": "sed *", "effect": "allow" },

    // Editors, formatters, and linters.
    { "action": "shell", "resource": "nvim *", "effect": "allow" },
    { "action": "shell", "resource": "vim *", "effect": "allow" },
    { "action": "shell", "resource": "stylua *", "effect": "allow" },
    { "action": "shell", "resource": "alejandra *", "effect": "allow" },
    { "action": "shell", "resource": "nixfmt *", "effect": "allow" },
    { "action": "shell", "resource": "statix *", "effect": "allow" },
    { "action": "shell", "resource": "deadnix *", "effect": "allow" },
    { "action": "shell", "resource": "shellcheck *", "effect": "allow" },
    { "action": "shell", "resource": "shfmt *", "effect": "allow" },

    // Hosted Jev calls may transmit their input externally.
    // Ask for each tool invocation so its payload can be reviewed.
    { "action": "jev_*", "resource": "*", "effect": "ask" },

    // Context Mode upgrades are owned by the flake.
    { "action": "ctx_upgrade", "resource": "*", "effect": "deny" },

    // Preserve V1's default prompt for access outside the project.
    // V2 otherwise allows external_directory access by default.
    { "action": "external_directory", "resource": "*", "effect": "ask" },

    // Trusted external directories.
    { "action": "external_directory", "resource": "/nix/store/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.config/nix/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.cache/nix/**", "effect": "allow" },

    // Project checkouts, Neovim plugin sources, skills, and scratch space.
    { "action": "external_directory", "resource": "~/projects/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.local/share/nvim/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.claude/skills/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/tmp/**", "effect": "allow" },

    // Key material and decrypted secrets: never read, edit or touch by path.
    // These are guardrails, not a sandbox: OpenCode has no OS isolation, so
    // a shell command that hides the path (e.g. inside a script) is not caught.
    // ssh itself keeps working through the agent; only file access is denied.
    { "action": "read", "resource": "~/.ssh/**", "effect": "deny" },
    { "action": "read", "resource": "~/.config/sops/**", "effect": "deny" },
    { "action": "read", "resource": "~/.config/sops-nix/**", "effect": "deny" },
    { "action": "read", "resource": "~/.local/secrets/**", "effect": "deny" },
    { "action": "read", "resource": "/run/user/*/secrets*/**", "effect": "deny" },
    { "action": "edit", "resource": "~/.ssh/**", "effect": "deny" },
    { "action": "edit", "resource": "~/.config/sops/**", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.ssh/**", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.config/sops/**", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.config/sops-nix/**", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.local/secrets/**", "effect": "deny" },
    { "action": "external_directory", "resource": "/run/user/*/secrets*/**", "effect": "deny" },
    // Persisted state and the Btrfs top level hold further copies of keys;
    // the rest of /persist and /mnt stays readable.
    { "action": "external_directory", "resource": "/persist/sops/**", "effect": "deny" },
    { "action": "read", "resource": "/persist/sops/**", "effect": "deny" },
    { "action": "external_directory", "resource": "/persist/home/*/.ssh/**", "effect": "deny" },
    { "action": "read", "resource": "/persist/home/*/.ssh/**", "effect": "deny" },
    { "action": "external_directory", "resource": "/persist/home/*/ssh_dms/**", "effect": "deny" },
    { "action": "read", "resource": "/persist/home/*/ssh_dms/**", "effect": "deny" },
    { "action": "external_directory", "resource": "/persist/home/*/.config/sops*/**", "effect": "deny" },
    { "action": "read", "resource": "/persist/home/*/.config/sops*/**", "effect": "deny" },
    { "action": "external_directory", "resource": "/persist/home/*/.local/secrets/**", "effect": "deny" },
    { "action": "read", "resource": "/persist/home/*/.local/secrets/**", "effect": "deny" },
    { "action": "external_directory", "resource": "/mnt/@home/*/.ssh/**", "effect": "deny" },
    { "action": "read", "resource": "/mnt/@home/*/.ssh/**", "effect": "deny" },
    { "action": "external_directory", "resource": "/mnt/@home/*/ssh_dms/**", "effect": "deny" },
    { "action": "read", "resource": "/mnt/@home/*/ssh_dms/**", "effect": "deny" },
    { "action": "external_directory", "resource": "/mnt/@home/*/.config/sops*/**", "effect": "deny" },
    { "action": "read", "resource": "/mnt/@home/*/.config/sops*/**", "effect": "deny" },
    { "action": "external_directory", "resource": "/mnt/@home/*/.local/secrets/**", "effect": "deny" },
    { "action": "read", "resource": "/mnt/@home/*/.local/secrets/**", "effect": "deny" },

    // Environment files may hold credentials; templates stay readable.
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.envrc", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "edit", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": "*.envrc", "effect": "deny" },
    // Catches `cat .env`, `grep … .envrc` etc.; also blocks harmless commands
    // that merely mention `.env` (e.g. `--env-file .env`).
    { "action": "shell", "resource": "*.env*", "effect": "deny" },
  ],
}

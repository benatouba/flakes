{
  "$schema": "https://opencode.ai/config.json",

  "plugins": [
    // Requires a V2-compatible release; renaming this key does not port the plugin.
    "envsitter-guard@latest",
    "@tarquinen/opencode-dcp@latest",
  ],
  "lsp": true,
  "mcp": {
    "servers": {
      "vuetify-mcp": {
        "type": "remote",
        "url": "https://mcp.vuetifyjs.com/mcp",
        "disabled": false,
        "timeout": {
          "catalog": 5000,
          "execution": 5000,
        },
      },
      "playwright": {
        "type": "local",
        "command": ["playwright-mcp"],
        "disabled": true,
      },

      "agent-browser": {
        "type": "local",
        "command": ["agent-browser", "mcp", "--tools", "core,debug"],
        "disabled": true,
      },

      "jev": {
        "type": "local",
        "command": ["jev-mcp"],
        "disabled": false,
      },

      "chrome-devtools": {
        "type": "local",
        "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
        "disabled": true,
      },
    },
  },

  "permissions": [
    // Skills and read-only discovery tools.
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },

    // Ask before edits; disallow edits through these tools in the Nix store.
    { "action": "edit", "resource": "*", "effect": "ask" },
    { "action": "edit", "resource": "/nix/store/**", "effect": "deny" },

    // Shell commands ask by default, with the original exceptions below.
    { "action": "shell", "resource": "*", "effect": "ask" },

    // Version control and forge.
    { "action": "shell", "resource": "git *", "effect": "allow" },
    { "action": "shell", "resource": "gh *", "effect": "allow" },
    { "action": "shell", "resource": "jj *", "effect": "allow" },

    // Nix and development environments.
    // These broad allowances include more than read-only inspection.
    { "action": "shell", "resource": "nix *", "effect": "allow" },
    { "action": "shell", "resource": "devenv *", "effect": "allow" },
    { "action": "shell", "resource": "direnv *", "effect": "allow" },
    { "action": "shell", "resource": "just *", "effect": "allow" },

    // Shell introspection and coreutils.
    { "action": "shell", "resource": "which *", "effect": "allow" },
    { "action": "shell", "resource": "command *", "effect": "allow" },
    { "action": "shell", "resource": "type *", "effect": "allow" },
    { "action": "shell", "resource": "pwd *", "effect": "allow" },
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "cat *", "effect": "allow" },
    { "action": "shell", "resource": "head *", "effect": "allow" },
    { "action": "shell", "resource": "tail *", "effect": "allow" },
    { "action": "shell", "resource": "wc *", "effect": "allow" },
    { "action": "shell", "resource": "tree *", "effect": "allow" },
    { "action": "shell", "resource": "file *", "effect": "allow" },
    { "action": "shell", "resource": "stat *", "effect": "allow" },
    { "action": "shell", "resource": "realpath *", "effect": "allow" },
    { "action": "shell", "resource": "readlink *", "effect": "allow" },
    { "action": "shell", "resource": "echo *", "effect": "allow" },
    { "action": "shell", "resource": "printf *", "effect": "allow" },
    { "action": "shell", "resource": "diff *", "effect": "allow" },

    // Search, filtering, and structured-data inspection.
    { "action": "shell", "resource": "grep *", "effect": "allow" },
    { "action": "shell", "resource": "rg *", "effect": "allow" },
    { "action": "shell", "resource": "fd *", "effect": "allow" },
    { "action": "shell", "resource": "find *", "effect": "allow" },
    { "action": "shell", "resource": "jq *", "effect": "allow" },
    { "action": "shell", "resource": "yq *", "effect": "allow" },
    { "action": "shell", "resource": "perl *", "effect": "allow" },
    { "action": "shell", "resource": "awk *", "effect": "allow" },
    { "action": "shell", "resource": "sed *", "effect": "allow" },

    // Editors, formatters, and linters.
    { "action": "shell", "resource": "nvim *", "effect": "allow" },
    { "action": "shell", "resource": "vim *", "effect": "allow" },
    { "action": "shell", "resource": "stylua *", "effect": "allow" },
    { "action": "shell", "resource": "alejandra *", "effect": "allow" },
    { "action": "shell", "resource": "nixfmt *", "effect": "allow" },
    { "action": "shell", "resource": "statix *", "effect": "allow" },
    { "action": "shell", "resource": "deadnix *", "effect": "allow" },
    { "action": "shell", "resource": "shellcheck *", "effect": "allow" },
    { "action": "shell", "resource": "shfmt *", "effect": "allow" },

    // Hosted Jev calls may transmit their input externally.
    // Ask for each tool invocation so its payload can be reviewed.
    { "action": "jev_*", "resource": "*", "effect": "ask" },

    // Preserve V1's default prompt for access outside the project.
    // V2 otherwise allows external_directory access by default.
    { "action": "external_directory", "resource": "*", "effect": "ask" },

    // Trusted external directories.
    { "action": "external_directory", "resource": "/nix/store/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.config/nix/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.cache/nix/**", "effect": "allow" },

    // Project checkouts, Neovim plugin sources, skills, and scratch space.
    { "action": "external_directory", "resource": "~/projects/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.local/share/nvim/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.claude/skills/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/tmp/**", "effect": "allow" },
  ],
}

{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "envsitter-guard@0.0.4"
  ],
  "lsp": true,
  "mcp": {
    "vuetify-mcp": {
      "type": "remote",
      "url": "https://mcp.vuetifyjs.com/mcp",
      "enabled": true,
      "timeout": 5000
    },
    "playwright": {
      "type": "local",
      "command": ["playwright-mcp"],
      "enabled": false
    },
    // Token-efficient agent browser (CLI-first; MCP is opt-in per project).
    // `core` = navigate/snapshot/interact/screenshot/eval, `debug` adds
    // console/errors/tracing/a11y audit for broken frontends. Primary use
    // is the CLI via Bash (`agent-browser open/snapshot -i/click @eN`),
    // taught by ~/.claude/skills/agent-browser (zero schema overhead).
    "agent-browser": {
      "type": "local",
      "command": ["agent-browser", "mcp", "--tools", "core,debug"],
      "enabled": false
    },
    "jev": {
      "type": "local",
      "command": ["jev-mcp"],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": false
    }
  },
  "permission": {
    "skill": {
      "*": "allow",
    },
    "read": {
      "*": "allow"
    },
    // Read-only discovery tools: safe to run without prompting.
    "glob": {
      "*": "allow"
    },
    "grep": {
      "*": "allow"
    },
    "edit": {
      "*": "ask",
      "/nix/store/**": "deny"
    },
    "bash": {
      "*": "ask",
      // Version control and forge.
      "git *": "allow",
      "gh *": "allow",
      "jj *": "allow",
      // Nix / dev environment inspection (read-only status, eval, search).
      "nix *": "allow",
      "devenv *": "allow",
      "direnv *": "allow",
      "just *": "allow",
      // Shell introspection and coreutils (no writes, no deletes).
      "which *": "allow",
      "command *": "allow",
      "type *": "allow",
      "pwd *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "tree *": "allow",
      "file *": "allow",
      "stat *": "allow",
      "realpath *": "allow",
      "readlink *": "allow",
      "echo *": "allow",
      "printf *": "allow",
      "diff *": "allow",
      // Search, filter, and structured-data inspection.
      "grep *": "allow",
      "rg *": "allow",
      "fd *": "allow",
      "find *": "allow",
      "jq *": "allow",
      "yq *": "allow",
      "perl *": "allow",
      "awk *": "allow",
      "sed *": "allow",
      // Headless editor checks and formatters/linters.
      "nvim *": "allow",
      "vim *": "allow",
      "stylua *": "allow",
      "alejandra *": "allow",
      "nixfmt *": "allow",
      "statix *": "allow",
      "deadnix *": "allow",
      "shellcheck *": "allow",
      "shfmt *": "allow",
      // Explicitly keep destructive / privilege-escalating commands on ask.
      // Covered by "*": "ask" above: rm *, sudo *, chmod *, chown *,
      // curl *|sh, wget *|sh, mkfs *, dd *.
    },
    // Hosted Jev calls may transmit their input externally; inspect each payload.
    "jev_*": "ask",
    "external_directory": {
      "/nix/store/**": "allow",
      "~/.config/nix/**": "allow",
      "~/.cache/nix/**": "allow",
      // Directories allowlisted from live agent sessions: project checkouts,
      // Neovim plugin sources, agent skills, and scratch space.
      "~/projects/**": "allow",
      "~/.local/share/nvim/**": "allow",
      "~/.claude/skills/**": "allow",
      "/tmp/**": "allow"
    }
  }
}

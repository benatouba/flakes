{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "envsitter-guard@0.0.4",
    "@tarquinen/opencode-dcp@3.2.0"
  ],
  "lsp": true,
  "mcp": {
    "vuetify-mcp": {
      "type": "remote",
      "url": "https://mcp.vuetifyjs.com/mcp",
      "enabled": true,
      "timeout": 5000
    },
    "playwright": {
      "type": "local",
      "command": ["playwright-mcp"],
      "enabled": false
    },
    // Token-efficient agent browser (CLI-first; MCP is opt-in per project).
    // `core` = navigate/snapshot/interact/screenshot/eval, `debug` adds
    // console/errors/tracing/a11y audit for broken frontends. Primary use
    // is the CLI via Bash (`agent-browser open/snapshot -i/click @eN`),
    // taught by ~/.claude/skills/agent-browser (zero schema overhead).
    "agent-browser": {
      "type": "local",
      "command": ["agent-browser", "mcp", "--tools", "core,debug"],
      "enabled": false
    },
    "jev": {
      "type": "local",
      "command": ["jev-mcp"],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": false
    }
  },
  "permission": {
    "skill": {
      "*": "allow",
    },
    "read": {
      "*": "allow"
    },
    "edit": {
      "*": "ask",
      "/nix/store/**": "deny"
    },
    "bash": {
      "*": "ask"
    },
    // Hosted Jev calls may transmit their input externally; inspect each payload.
    "jev_*": "ask",
    "external_directory": {
      "/nix/store/**": "allow",
      "~/.config/nix/**": "allow",
      "~/.cache/nix/**": "allow"
    }
  }
}

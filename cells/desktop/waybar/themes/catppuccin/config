{
	"layer": "top",
	"position": "top",
	"spacing": 4,
	"modules-left": [
		"hyprland/workspaces",
		"hyprland/window"
	],
	"modules-center": [
		"clock"
	],
	"modules-right": [
		"mpris",
		"idle_inhibitor",
		"custom/nightlight",
		"group/stats",
		"pulseaudio",
		"pulseaudio#source",
		"backlight",
		"network",
		"bluetooth",
		"battery",
		"custom/notification",
		"hyprland/language",
		"tray",
		"custom/power"
	],
	"hyprland/workspaces": {
		"on-click": "activate",
		"on-scroll-up": "hyprctl dispatch workspace e-1",
		"on-scroll-down": "hyprctl dispatch workspace e+1",
		"format": "{icon}",
		"all-outputs": true,
		"format-icons": {
			"terminal": "",
			"web": "󰖟",
			"music": "󰝚",
			"email": "󰇮",
			"active": "",
			"default": "",
			"urgent": ""
		}
	},
	"hyprland/window": {
		"format": "{title}",
		"max-length": 60,
		"separate-outputs": true,
		"tooltip-format": "{title}",
		"on-click-middle": "hyprctl dispatch killactive"
	},
	"idle_inhibitor": {
		"format": "{icon}",
		"format-icons": {
			"activated": "󰅶",
			"deactivated": "󰾪"
		},
		"on-click-right": "hyprlock",
		"tooltip-format-activated": "Idle inhibitor: active (screen stays awake)",
		"tooltip-format-deactivated": "Idle inhibitor: inactive (will sleep on idle)"
	},
	"custom/nightlight": {
		"format": "{}",
		"return-type": "json",
		"interval": 5,
		"exec": "bash ~/.config/waybar/scripts/nightlight.sh",
		"menu": "on-click",
		"menu-file": "~/.config/waybar/menus/nightlight.xml",
		"menu-actions": {
			"warm": "bash -c 'hyprctl hyprsunset temperature 4000 && printf 4000 > \"${XDG_RUNTIME_DIR:-/tmp}/waybar-nightlight\"'",
			"evening": "bash -c 'hyprctl hyprsunset temperature 5200 && printf 5200 > \"${XDG_RUNTIME_DIR:-/tmp}/waybar-nightlight\"'",
			"off": "bash -c 'hyprctl hyprsunset identity && printf off > \"${XDG_RUNTIME_DIR:-/tmp}/waybar-nightlight\"'"
		}
	},
	"clock": {
		"tooltip-format": "<tt><small>{calendar}</small></tt>",
		"actions": {
			"on-click-right": "mode"
		},
		"calendar": {
			"mode": "year",
			"mode-mon-col": 3,
			"weeks-pos": "right",
			"on-scroll": 1,
			"format": {
				"months": "<span color='#ffead3'><b>{}</b></span>",
				"days": "<span color='#ecc6d9'><b>{}</b></span>",
				"weeks": "<span color='#99ffdd'><b>W{}</b></span>",
				"weekdays": "<span color='#ffcc66'><b>{}</b></span>",
				"today": "<span color='#ff6699'><b><u>{}</u></b></span>"
			}
		},
		"format": "  {:%a %H:%M}",
		"format-alt": "  {:%A, %d %B %Y}",
		"interval": 60,
		"menu": "on-click-middle",
		"menu-file": "~/.config/waybar/menus/clock.xml",
		"menu-actions": {
			"copy-date": "bash -c 'date +%F | wl-copy'",
			"copy-time": "bash -c 'date +%H:%M | wl-copy'",
			"copy-week": "bash -c 'date +%G-W%V | wl-copy'",
			"copy-stamp": "bash -c 'date --iso-8601=seconds | wl-copy'"
		}
	},
	"mpris": {
		"format": "{status_icon} {dynamic}",
		"format-stopped": "{status_icon}",
		"status-icons": {
			"playing": "󰏤",
			"paused": "󰐊",
			"stopped": "󰓛"
		},
		"dynamic-order": [
			"title",
			"artist"
		],
		"dynamic-separator": "  ·  ",
		"dynamic-len": 40,
		"tooltip-format": "{status_icon} {title}\n{artist}\n{album}",
		"on-click-middle": "playerctl next",
		"on-click-right": "playerctl previous",
		"on-scroll-up": "playerctl previous",
		"on-scroll-down": "playerctl next"
	},
	"group/stats": {
		"orientation": "horizontal",
		"drawer": {
			"transition-duration": 300,
			"children-class": "stats-item",
			"transition-left-to-right": false
		},
		"modules": [
			"cpu",
			"memory",
			"disk"
		]
	},
	"cpu": {
		"format": " {usage}%",
		"on-click": "wezterm start --always-new-process --class org.waybar.btop -- btop",
		"tooltip": true,
		"interval": 5
	},
	"memory": {
		"format": " {}%",
		"on-click": "wezterm start --always-new-process --class org.waybar.btop -- btop",
		"tooltip-format": "{used:0.1f}G / {total:0.1f}G used",
		"interval": 5
	},
	"disk": {
		"interval": 30,
		"format": "󰋊 {percentage_used}%",
		"path": "/",
		"on-click": "wezterm start --always-new-process --class org.waybar.btop -- btop",
		"tooltip-format": "{used} / {total} used on {path}"
	},
	"network": {
		"format-wifi": "{icon} {essid} ({signalStrength}%)",
		"format-ethernet": "󰈀 {ifname}",
		"format-disconnected": "󰤮 Disconnected",
		"format-icons": [
			"󰤯",
			"󰤟",
			"󰤢",
			"󰤥",
			"󰤨"
		],
		"on-click-right": "bash -c 'if [ \"$(nmcli -t -f WIFI g)\" = enabled ]; then nmcli radio wifi off; else nmcli radio wifi on; fi'",
		"on-click-middle": "wezterm start --always-new-process --class org.waybar.nmtui -- nmtui",
		"tooltip-format-wifi": "{icon} {ifname} @ {essid}\nIP: {ipaddr}\nStrength: {signalStrength}%\nFreq: {frequency}MHz\nUp: {bandwidthUpBits} Down: {bandwidthDownBits}",
		"tooltip-format-ethernet": "󰈀 {ifname}\nIP: {ipaddr}\nUp: {bandwidthUpBits} Down: {bandwidthDownBits}",
		"tooltip-format-disconnected": "Disconnected",
		"max-length": 30,
		"menu": "on-click",
		"menu-file": "~/.config/waybar/menus/network.xml",
		"menu-actions": {
			"networks": "wezterm start --always-new-process --class org.waybar.nmtui -- nmtui",
			"wifi-on": "nmcli radio wifi on",
			"wifi-off": "nmcli radio wifi off",
			"reconnect": "bash -c 'nmcli networking off && sleep 1 && nmcli networking on'",
			"copy-ip": "bash -c 'ip -4 -j addr show scope global | jq -r \".[0].addr_info[0].local\" | wl-copy'"
		}
	},
	"bluetooth": {
		"format": "󰂯 {status}",
		"format-connected": "󰂱 {device_alias}",
		"format-connected-battery": "󰂱 {device_alias} {device_battery_percentage}%",
		"format-disabled": "󰂲",
		"format-off": "󰂲",
		"format-no-controller": "",
		"on-click-right": "rfkill toggle bluetooth",
		"on-click-middle": "wezterm start --always-new-process --class org.waybar.bluetui -- bluetui",
		"tooltip-format": "{controller_alias}\n{num_connections} connected",
		"tooltip-format-connected": "{controller_alias}\n\n{device_enumerate}",
		"tooltip-format-enumerate-connected": "{device_alias}",
		"tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_battery_percentage}%",
		"menu": "on-click",
		"menu-file": "~/.config/waybar/menus/bluetooth.xml",
		"menu-actions": {
			"devices": "wezterm start --always-new-process --class org.waybar.bluetui -- bluetui",
			"on": "rfkill unblock bluetooth",
			"off": "rfkill block bluetooth"
		}
	},
	"battery": {
		"states": {
			"warning": 30,
			"critical": 15
		},
		"format": "{icon} {capacity}%",
		"format-charging": "{icon} {capacity}%",
		"format-plugged": "󰚥 {capacity}%",
		"format-alt": "{icon} {time}",
		"format-icons": {
			"charging": [
				"󰢜",
				"󰂆",
				"󰂇",
				"󰂈",
				"󰢝",
				"󰂉",
				"󰢞",
				"󰂊",
				"󰂋",
				"󰂅"
			],
			"default": [
				"󰁺",
				"󰁻",
				"󰁼",
				"󰁽",
				"󰁾",
				"󰁿",
				"󰂀",
				"󰂁",
				"󰂂",
				"󰁹"
			]
		},
		"on-click-right": "~/.config/hypr/scripts/toggle-charge.sh",
		"on-click-middle": "wezterm start --always-new-process --class org.waybar.btop -- btop",
		"tooltip-format": "{timeTo}\nPower: {power:.1f}W",
		"menu": "on-click",
		"menu-file": "~/.config/waybar/menus/battery.xml",
		"menu-actions": {
			"lock": "hyprlock",
			"suspend": "systemctl suspend",
			"logout": "hyprctl dispatch exit",
			"reboot": "systemctl reboot",
			"shutdown": "systemctl poweroff",
			"charge": "bash ~/.config/hypr/scripts/toggle-charge.sh",
			"monitor": "wezterm start --always-new-process --class org.waybar.btop -- btop"
		}
	},
	"pulseaudio": {
		"format": "{icon} {volume}%",
		"format-muted": "󰝟 muted",
		"format-icons": {
			"headphone": "󰋋",
			"headset": "󰋎",
			"hands-free": "󰋎",
			"phone": "󰏲",
			"portable": "󰦧",
			"car": "󰄋",
			"hdmi": "󰡁",
			"default": [
				"󰕿",
				"󰖀",
				"󰕾"
			]
		},
		"tooltip-format": "{desc}\nVolume {volume}%",
		"scroll-step": 5,
		"max-volume": 100,
		"on-click-right": "pamixer -t",
		"on-click-middle": "wezterm start --always-new-process --class org.waybar.wiremix -- wiremix",
		"menu": "on-click",
		"menu-file": "~/.config/waybar/menus/audio.xml",
		"menu-actions": {
			"mixer": "wezterm start --always-new-process --class org.waybar.wiremix -- wiremix",
			"mute": "pamixer -t",
			"mute-mic": "pamixer --default-source -t",
			"vol-0": "pamixer --set-volume 0",
			"vol-25": "pamixer --set-volume 25",
			"vol-50": "pamixer --set-volume 50",
			"vol-75": "pamixer --set-volume 75",
			"vol-100": "pamixer --set-volume 100"
		}
	},
	"pulseaudio#source": {
		"format": "{format_source}",
		"format-source": "󰍬 {volume}%",
		"format-source-muted": "󰍭",
		"tooltip-format": "Microphone: {format_source}",
		"scroll-step": 5,
		"on-click": "pamixer --default-source -t",
		"on-click-right": "pamixer --default-source -t",
		"on-click-middle": "wezterm start --always-new-process --class org.waybar.wiremix -- wiremix"
	},
	"backlight": {
		"format": "{icon} {percent}%",
		"format-icons": [
			"",
			"",
			"",
			"",
			"",
			"",
			"",
			"",
			""
		],
		"tooltip-format": "Brightness {percent}%",
		"scroll-step": 5,
		"menu": "on-click",
		"menu-file": "~/.config/waybar/menus/backlight.xml",
		"menu-actions": {
			"b-25": "brightnessctl -c backlight set 25%",
			"b-50": "brightnessctl -c backlight set 50%",
			"b-75": "brightnessctl -c backlight set 75%",
			"b-100": "brightnessctl -c backlight set 100%"
		}
	},
	"custom/notification": {
		"tooltip-format": "Left: Toggle notifications\nRight: Do not disturb",
		"format": "{icon}",
		"format-icons": {
			"notification": "󱅫",
			"none": "󰂚",
			"dnd-notification": "󱅫",
			"dnd-none": "󰂛",
			"inhibited-notification": "󱅫",
			"inhibited-none": "󰂚",
			"dnd-inhibited-notification": "󰂛",
			"dnd-inhibited-none": "󰂛"
		},
		"return-type": "json",
		"exec-if": "which swaync-client",
		"exec": "swaync-client -swb",
		"on-click": "swaync-client -t -sw",
		"on-click-right": "swaync-client -d -sw",
		"escape": true
	},
	"hyprland/language": {
		"format": "󰌌 {short}",
		"tooltip-format": "{long}",
		"on-click": "hyprctl switchxkblayout all next"
	},
	"tray": {
		"icon-size": 16,
		"spacing": 10
	},
	"custom/power": {
		"tooltip-format": "Left: power menu\nRight: lock screen",
		"on-click": "wlogout &",
		"on-click-right": "hyprlock",
		"format": "⏻"
	}
}
